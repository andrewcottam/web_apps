rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the people listed here can read or write stays (each person only their own).
    // Replace with the Google account emails of everyone who should have access.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'a.cottam@gmail.com',
          'lynda.cottam@gmail.com'
        ];
    }
    // Each person's stays are stored in their own document, keyed by their auth uid.
    match /eu-stays/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
