rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the people listed here can read or write the shared stays document.
    // Replace with the Google account emails of everyone who should have access.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'you@example.com',
          'partner@example.com'
        ];
    }
    match /eu-stays/shared {
      allow read, write: if allowed();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
